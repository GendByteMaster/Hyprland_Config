#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_NAME="gendbyte-workspace-overview"
CONFIG_DIR="$CONFIG_HOME/quickshell/$CONFIG_NAME"
RUNTIME_ROOT="${XDG_RUNTIME_DIR:-/tmp}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
THEME_COLORS="$STATE_HOME/omarchy/current/theme/colors.toml"
if [[ ! -f "$THEME_COLORS" ]]; then
  LEGACY_THEME_COLORS="$CONFIG_HOME/omarchy/current/theme/colors.toml"
  if [[ -f "$LEGACY_THEME_COLORS" ]]; then
    THEME_COLORS="$LEGACY_THEME_COLORS"
  else
    THEME_COLORS=""
  fi
fi
LOG_DIR="$STATE_HOME/hyprland_config"
LOG_FILE="$LOG_DIR/workspace-overview.log"
LOCK_DIR="$RUNTIME_ROOT/gendbyte-workspace-overview-${UID:-$(id -u)}.lock"
STARTUP_ATTEMPTS=100
STARTUP_DELAY=0.05

MODE="${1:-overview}"
case "$MODE" in
  overview)
    IPC_TOGGLE="toggle"
    IPC_SHOW="show"
    ;;
  task-switcher)
    IPC_TOGGLE="toggleSwitcher"
    IPC_SHOW="showSwitcher"
    ;;
  *)
    echo "usage: $0 [overview|task-switcher]" >&2
    exit 2
    ;;
esac

if [[ -f "$CONFIG_DIR/shell.qml" ]]; then
  QS_SELECTOR=(-c "$CONFIG_NAME")
else
  CONFIG_DIR="$REPO_ROOT/quickshell/gendbyte-workspace-overview"
  QS_SELECTOR=(-p "$CONFIG_DIR")
fi

mkdir -p "$LOG_DIR"

qs_config() {
  qs "${QS_SELECTOR[@]}" "$@"
}

ipc() {
  qs_config ipc call gendbyte-workspace-overview "$1"
}

wait_for_ipc() {
  local attempt=0
  while (( attempt < STARTUP_ATTEMPTS )); do
    if ipc ping >/dev/null 2>&1; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep "$STARTUP_DELAY"
  done
  return 1
}

if ipc "$IPC_TOGGLE" >/dev/null 2>&1; then
  exit 0
fi

lock_owned=0

cleanup_lock() {
  if (( lock_owned == 1 )); then
    rm -rf -- "$LOCK_DIR"
  fi
}

trap cleanup_lock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

acquire_start_lock() {
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    printf '%s\n' "$$" > "$LOCK_DIR/pid"
    lock_owned=1
    return 0
  fi

  local owner_pid=""
  if [[ -r "$LOCK_DIR/pid" ]]; then
    read -r owner_pid < "$LOCK_DIR/pid" || true
  fi

  if [[ "$owner_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
    rm -rf -- "$LOCK_DIR"
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      printf '%s\n' "$$" > "$LOCK_DIR/pid"
      lock_owned=1
      return 0
    fi
  fi

  return 1
}

if ! acquire_start_lock; then
  if wait_for_ipc; then
    ipc "$IPC_TOGGLE"
    exit 0
  fi

  echo "Workspace Overview startup is busy but IPC did not become ready" >&2
  exit 1
fi

if ipc "$IPC_TOGGLE" >/dev/null 2>&1; then
  exit 0
fi

export QS_NO_RELOAD_POPUP=1
export OMARCHY_THEME_COLORS="$THEME_COLORS"

setsid qs "${QS_SELECTOR[@]}" >>"$LOG_FILE" 2>&1 &

if wait_for_ipc; then
  ipc "$IPC_SHOW"
  exit 0
fi

printf '%s Workspace Overview failed to become IPC-ready after 5s\n' \
  "$(date --iso-8601=seconds 2>/dev/null || date)" >>"$LOG_FILE"
echo "Workspace Overview failed to start; see $LOG_FILE" >&2
exit 1
