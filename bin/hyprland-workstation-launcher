#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_NAME="gendbyte-project-launcher"
CONFIG_DIR="$CONFIG_HOME/quickshell/$CONFIG_NAME"
RUNTIME_ROOT="${XDG_RUNTIME_DIR:-/tmp}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
THEME_COLORS="$STATE_HOME/omarchy/current/theme/colors.toml"
if [[ ! -f "$THEME_COLORS" ]]; then
  LEGACY_THEME_COLORS="$CONFIG_HOME/omarchy/current/theme/colors.toml"
  if [[ -f "$LEGACY_THEME_COLORS" ]]; then
    THEME_COLORS="$LEGACY_THEME_COLORS"
  else
    THEME_COLORS=""
  fi
fi
LOG_DIR="$STATE_HOME/hyprland_config"
LOG_FILE="$LOG_DIR/project-launcher.log"
LOCK_DIR="$RUNTIME_ROOT/gendbyte-project-launcher-${UID:-$(id -u)}.lock"
STARTUP_ATTEMPTS=100
STARTUP_DELAY=0.05

if [[ -f "$CONFIG_DIR/shell.qml" ]]; then
  QS_SELECTOR=(-c "$CONFIG_NAME")
else
  CONFIG_DIR="$REPO_ROOT/quickshell/gendbyte-project-launcher"
  QS_SELECTOR=(-p "$CONFIG_DIR")
fi

mkdir -p "$LOG_DIR"

qs_config() {
  qs "${QS_SELECTOR[@]}" "$@"
}

ipc() {
  qs_config ipc call gendbyte-project-launcher "$1"
}

wait_for_ipc() {
  local attempt=0
  while (( attempt < STARTUP_ATTEMPTS )); do
    if ipc ping >/dev/null 2>&1; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep "$STARTUP_DELAY"
  done
  return 1
}

if ipc ping >/dev/null 2>&1; then
  ipc toggle >/dev/null 2>&1
  exit 0
fi

lock_owned=0

cleanup_lock() {
  if (( lock_owned == 1 )); then
    rm -rf -- "$LOCK_DIR"
  fi
}

trap cleanup_lock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

acquire_start_lock() {
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    printf '%s\n' "$$" > "$LOCK_DIR/pid"
    lock_owned=1
    return 0
  fi

  local owner_pid=""
  if [[ -r "$LOCK_DIR/pid" ]]; then
    read -r owner_pid < "$LOCK_DIR/pid" || true
  fi

  if [[ "$owner_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$owner_pid" 2>/dev/null; then
    rm -rf -- "$LOCK_DIR"
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      printf '%s\n' "$$" > "$LOCK_DIR/pid"
      lock_owned=1
      return 0
    fi
  fi

  return 1
}

if ! acquire_start_lock; then
  # Another wrapper owns the cold start. This invocation must converge on
  # "visible" instead of toggling whatever state the starter just produced.
  if wait_for_ipc; then
    ipc show >/dev/null 2>&1
    exit 0
  fi

  echo "Project Launcher startup is busy but IPC did not become ready" >&2
  exit 1
fi

# A launcher may have become ready between the first readiness check and lock
# acquisition. Cold-start intent is always "show", never "toggle".
if ipc ping >/dev/null 2>&1; then
  ipc show >/dev/null 2>&1
  exit 0
fi

export HYPRLAND_WORKSTATION_REPO_ROOT="$REPO_ROOT"
export OMARCHY_THEME_COLORS="$THEME_COLORS"
export QS_NO_RELOAD_POPUP=1

setsid qs "${QS_SELECTOR[@]}" >>"$LOG_FILE" 2>&1 &

if wait_for_ipc; then
  ipc show >/dev/null 2>&1
  exit 0
fi

printf '%s Project Launcher failed to become IPC-ready after 5s\n' \
  "$(date --iso-8601=seconds 2>/dev/null || date)" >>"$LOG_FILE"
echo "Project Launcher failed to start; see $LOG_FILE" >&2
exit 1
