#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_DIR="$CONFIG_HOME/quickshell/gendbyte-project-launcher"

if [[ ! -f "$CONFIG_DIR/shell.qml" ]]; then
  CONFIG_DIR="$REPO_ROOT/quickshell/gendbyte-project-launcher"
fi

if qs -p "$CONFIG_DIR" ipc call gendbyte-project-launcher toggle >/dev/null 2>&1; then
  exit 0
fi

export HYPRLAND_WORKSTATION_REPO_ROOT="$REPO_ROOT"
export QS_NO_RELOAD_POPUP=1

setsid qs -p "$CONFIG_DIR" >/dev/null 2>&1 &

for _ in $(seq 1 20); do
  if qs -p "$CONFIG_DIR" ipc call gendbyte-project-launcher ping >/dev/null 2>&1; then
    exec qs -p "$CONFIG_DIR" ipc call gendbyte-project-launcher show
  fi
  sleep 0.05
done

echo "Project Launcher failed to start" >&2
exit 1
